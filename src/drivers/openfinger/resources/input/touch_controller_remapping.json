{
  "to_controller_type": "oculus_touch",
  "layouts": [
    {
      "priority": 100,
      "from_controller_type": "oculus_touch",
      "simulate_controller_type": true,
      "simulate_render_model": true,
      "simulate_HMD": true,
      "autoremappings": [
        { "from": "/user/hand/left/input/trigger", "to": "/user/hand/left/input/trigger" },
        { "from": "/user/hand/right/input/trigger", "to": "/user/hand/right/input/trigger" },
        { "from": "/user/hand/left/input/grip", "to": "/user/hand/left/input/grip" },
        { "from": "/user/hand/right/input/grip", "to": "/user/hand/right/input/grip" },
        { "from": "/user/hand/left/input/joystick", "to": "/user/hand/left/input/joystick" },
        { "from": "/user/hand/right/input/joystick", "to": "/user/hand/right/input/joystick" },
        { "from": "/user/hand/left/input/x", "to": "/user/hand/left/input/x", "mirror": false },
        { "from": "/user/hand/left/input/y", "to": "/user/hand/left/input/y", "mirror": false },
        { "from": "/user/hand/right/input/a", "to": "/user/hand/right/input/a", "mirror": false },
        { "from": "/user/hand/right/input/b", "to": "/user/hand/right/input/b", "mirror": false },
        { "from": "/user/hand/left/input/system", "to": "/user/hand/left/input/system", "mirror": false },
        { "from": "/user/hand/right/input/system", "to": "/user/hand/right/input/system", "mirror": false },
        { "from": "/user/hand/left/input/skeleton/left", "to": "/user/hand/left/input/skeleton/left" },
        { "from": "/user/hand/right/input/skeleton/right", "to": "/user/hand/right/input/skeleton/right" },
        { "from": "/user/hand/left/pose/raw", "to": "/user/hand/left/pose/raw" },
        { "from": "/user/hand/right/pose/raw", "to": "/user/hand/right/pose/raw" },
        { "from": "/user/hand/left/pose/base", "to": "/user/hand/left/pose/base" },
        { "from": "/user/hand/right/pose/base", "to": "/user/hand/right/pose/base" },
        { "from": "/user/hand/left/pose/handgrip", "to": "/user/hand/left/pose/handgrip" },
        { "from": "/user/hand/right/pose/handgrip", "to": "/user/hand/right/pose/handgrip" },
        { "from": "/user/hand/left/pose/openxr_grip", "to": "/user/hand/left/pose/openxr_grip" },
        { "from": "/user/hand/right/pose/openxr_grip", "to": "/user/hand/right/pose/openxr_grip" },
        { "from": "/user/hand/left/pose/openxr_aim", "to": "/user/hand/left/pose/openxr_aim" },
        { "from": "/user/hand/right/pose/openxr_aim", "to": "/user/hand/right/pose/openxr_aim" },
        { "from": "/user/hand/left/pose/tip", "to": "/user/hand/left/pose/tip" },
        { "from": "/user/hand/right/pose/tip", "to": "/user/hand/right/pose/tip" },
        { "from": "/user/hand/left/output/haptic", "to": "/user/hand/left/output/haptic" },
        { "from": "/user/hand/right/output/haptic", "to": "/user/hand/right/output/haptic" }
      ]
    }
  ]
}
