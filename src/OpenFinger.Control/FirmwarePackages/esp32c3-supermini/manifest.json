    "joystick_vrx_pin": -1,
    "joystick_vry_pin": -1,
    "joystick_sw_pin": -1
  },
  "bootloader": {
    "file": "bootloader.bin",
    "offset": "0x0000"
  },
  "partitions": {
    "file": "partitions.bin",
    "offset": "0x8000"
  },
  "firmware": {
    "file": "firmware.bin",
    "offset": "0x10000"
