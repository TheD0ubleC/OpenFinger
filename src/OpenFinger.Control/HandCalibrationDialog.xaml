<Window x:Class="OpenFinger.Control.HandCalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手指校准"
        Width="700"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="DialogSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="50" Height="26">
                            <Border x:Name="Bg"
                                    CornerRadius="8"
                                    Background="{DynamicResource BrushTrack}" />
                            <Border x:Name="Knob"
                                    Width="18"
                                    Height="18"
                                    Margin="4,0,4,0"
                                    CornerRadius="6"
                                    Background="{DynamicResource BrushPanel}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{DynamicResource ColorShadow}" Opacity="0.24" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="18"
            Style="{StaticResource CardBorderStyle}"
            Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleText"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"
                           Text="当前手校准" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource BrushSubText}"
                           TextWrapping="Wrap"
                           Text="按提示依次完成每根手指的伸直和弯曲记录。" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="高级模式"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource BrushSubText}" />
                <ToggleButton x:Name="AdvancedModeToggle"
                              Style="{StaticResource DialogSwitchStyle}"
                              Checked="OnAdvancedModeChanged"
                              Unchecked="OnAdvancedModeChanged" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="16"
                BorderBrush="{DynamicResource BrushActiveBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{DynamicResource BrushPrimarySoft}">
            <StackPanel>
                <TextBlock x:Name="StepText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Text="准备开始" />
                <TextBlock x:Name="InstructionText"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource BrushSubText}"
                           TextWrapping="Wrap"
                           Text="点击开始后，系统会依次提示你先伸直、再弯曲每根手指。" />
                <TextBlock x:Name="FriendlyHintText"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource BrushSubText}"
                           TextWrapping="Wrap"
                           Text="保持动作稳定一小会儿就可以，系统会自动取较稳的结果。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                CornerRadius="12"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                Background="{DynamicResource BrushPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="14,14,14,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Text="记录结果" />

                <Grid Grid.Row="1"
                      Margin="10,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource BrushInputReadonly}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="手指"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushSubText}" />
                            <TextBlock Grid.Column="1"
                                       Text="当前进度"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushSubText}" />
                            <TextBlock Grid.Column="2"
                                       Text="记录详情"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushSubText}"
                                       Visibility="{Binding ElementName=AdvancedModeToggle, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ResultItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="14,12"
                                            Background="{DynamicResource BrushPanel}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Summary}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource BrushText}" />

                                            <StackPanel Grid.Column="2"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding ElementName=AdvancedModeToggle, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Margin="0,0,0,6"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource BrushSubText}">
                                                    <Run Text="{Binding OpenRawText}" />
                                                    <Run Text="    " />
                                                    <Run Text="{Binding ClosedRawText}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource BrushSubText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="FooterText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushSubText}"
                       Text="准备好后点击开始。"
                       DockPanel.Dock="Left" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="StartButton"
                        Width="110"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="StartButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="开始" />
                <Button Width="90"
                        Height="38"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Content="取消" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </Border>
</Window>
