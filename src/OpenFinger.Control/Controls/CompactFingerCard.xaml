<UserControl x:Class="OpenFinger.Control.Controls.CompactFingerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Width="28"
                ToolTip="{Binding FingerName, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Width="24" Height="24" HorizontalAlignment="Center">
            <Ellipse Stroke="{DynamicResource BrushBorder}" StrokeThickness="3.2" Fill="{DynamicResource BrushPanel}" />
            <Path x:Name="ProgressArc"
                  Stroke="{DynamicResource BrushPrimary}"
                  StrokeThickness="3.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Grid>
        <TextBlock Text="{Binding FingerName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="0,3,0,0"
                   FontSize="9.5"
                   Foreground="{DynamicResource BrushSubText}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
