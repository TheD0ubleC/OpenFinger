<UserControl x:Class="OpenFinger.Control.Controls.FingerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding FingerName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BrushSubText}" />
                <TextBlock x:Name="RawTextLabel"
                           Text="ADC 实时输入"
                           FontSize="11"
                           Foreground="{DynamicResource BrushNeutralAccent}"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"
                           Visibility="Collapsed" />
            </DockPanel>

            <ProgressBar Grid.Row="1"
                         Height="8"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Margin="0,0,0,10"
                         Style="{StaticResource FingerProgressStyle}" />

            <TextBlock Grid.Row="2"
                       x:Name="SimpleTextVal"
                       Text="{Binding DisplayValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}" />

            <Grid Grid.Row="3"
                  x:Name="ProAdcGrid"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="当前 (ADC)" FontSize="10" Foreground="{DynamicResource BrushSubText}" />
                    <TextBlock x:Name="RawValueText" Text="1285" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="校准最低" FontSize="10" Foreground="{DynamicResource BrushSubText}" />
                    <TextBlock x:Name="MinAdcText" Text="1024" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccessAccent}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="校准最高" FontSize="10" Foreground="{DynamicResource BrushSubText}" />
                    <TextBlock x:Name="MaxAdcText" Text="4095" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushDangerText}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="4"
                    x:Name="ProAdcRangeBar"
                    Height="4"
                    CornerRadius="2"
                    Background="{DynamicResource BrushTrack}"
                    Margin="0,10,0,2"
                    Visibility="Collapsed"
                    SizeChanged="OnProAdcRangeBarSizeChanged">
                <Grid ClipToBounds="True">
                    <Canvas x:Name="ProAdcRangeCanvas">
                        <Border x:Name="ProAdcCalibratedRange"
                                Height="4"
                                Background="{DynamicResource BrushInfoAccent}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                        <Border x:Name="ProAdcPointer"
                                Width="2"
                                Height="10"
                                Background="{DynamicResource BrushPrimary}"
                                CornerRadius="1"
                                Canvas.Top="-3"
                                Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
