<UserControl x:Class="OpenFinger.Control.Controls.LabeledReadonlyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource BrushSubText}" />
        <TextBox Grid.Column="1"
                 Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 IsReadOnly="True"
                 Style="{StaticResource TextInputStyle}" />
    </Grid>
</UserControl>
