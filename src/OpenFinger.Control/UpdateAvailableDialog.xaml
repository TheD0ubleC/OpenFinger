<Window x:Class="OpenFinger.Control.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="548"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Margin="18"
            Padding="24"
            Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <TextBlock x:Name="DialogTitleText"
                       Text="发现新版本"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}" />
            <TextBlock x:Name="DialogDescriptionText"
                       Margin="0,8,0,0"
                       Text="检测到有新的 OpenFinger 发行版。你可以现在下载并更新，也可以稍后再处理。"
                       Foreground="{DynamicResource BrushSubText}"
                       TextWrapping="Wrap" />

            <Border Margin="0,20,0,0"
                    Background="{DynamicResource BrushPanelAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushInputReadonly}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="当前版本"
                                       Style="{StaticResource InputLabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="CurrentVersionText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource BrushInputReadonly}"
                            BorderBrush="{DynamicResource BrushActiveBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="可更新到"
                                       Style="{StaticResource InputLabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="LatestVersionText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushPrimary}" />
                            <TextBlock x:Name="PublishedText"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource BrushSubText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="SummarySection"
                        Margin="0,14,0,0">
                <TextBlock x:Name="ReleaseNameText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ReleaseAssetText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource BrushSubText}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="NotesSection"
                        Margin="0,16,0,0">
                <TextBlock Text="这次更新"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Margin="0,10,0,0"
                        Background="{DynamicResource BrushInputReadonly}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12">
                    <TextBlock x:Name="ReleaseNotesText"
                               Foreground="{DynamicResource BrushText}"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="DownloadHintText"
                       Margin="0,14,0,0"
                       Text="下载并更新会先拉取新的发行包，随后关闭当前窗口并完成本地替换。"
                       Foreground="{DynamicResource BrushSubText}"
                       TextWrapping="Wrap" />

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        MinWidth="0"
                        Content="稍后再说"
                        Click="OnLaterClick" />
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        MinWidth="0"
                        Content="忽略这个版本"
                        Click="OnIgnoreClick" />
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        MinWidth="0"
                        Content="查看发行页"
                        Click="OnViewReleaseClick" />
                <Button x:Name="DownloadButton"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="0"
                        Content="下载并更新"
                        Click="OnDownloadClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
