<UserControl x:Class="OpenFinger.Control.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OpenFinger.Control.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBg}"
             Style="{StaticResource PageTransitionStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,36" MaxWidth="1080">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:PageHeader Grid.Column="0"
                                     Title="校准与设置"
                                     Description="按单手顺序完成校准，并在同一页调整摇杆设置。"
                                     Margin="0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="专业模式"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource BrushSubText}" />
                    <ToggleButton x:Name="ProModeToggle"
                                  Width="52"
                                  Height="26"
                                  Cursor="Hand"
                                  Checked="OnProModeChanged"
                                  Unchecked="OnProModeChanged">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid>
                                    <Border x:Name="Bg" CornerRadius="13" Background="{DynamicResource BrushTrack}" BorderThickness="0" />
                                    <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,3,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="{DynamicResource ColorShadow}" Opacity="0.3" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Border x:Name="AdvancedModeBanner"
                    Background="{DynamicResource BrushInfoBg}"
                    BorderBrush="{DynamicResource BrushInfoBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,24"
                    Visibility="Collapsed">
                <TextBlock Text="高级模式已开启：当前会显示原始输入、校准区间和算法微调。"
                           Foreground="{DynamicResource BrushInfoText}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="十指与摇杆实时输入" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="展开时显示详细输入，收起后切换为紧凑概览。"
                                           Foreground="{DynamicResource BrushSubText}"
                                           FontSize="12.5"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="RealtimeToggleButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="112"
                                    Content="切换为概览"
                                    Click="OnRealtimeToggleClick" />
                        </Grid>

                        <StackPanel x:Name="DetailedRealtimePanel">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="左手控制器"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushPrimary}"
                                               Margin="0,0,0,12" />
                                    <controls:FingerCard x:Name="FingerLThumb" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerLIndex" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerLMiddle" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerLRing" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerLPinky" Margin="0,0,0,10" />

                                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushInputReadonly}" CornerRadius="12" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="94" Height="94" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource BrushPanel}" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1.2" />
                                                <Ellipse x:Name="LeftJoystickActiveRing" Width="62" Height="62" Fill="{DynamicResource BrushInfoBg}" Stroke="{DynamicResource BrushInfoBorder}" StrokeThickness="1" />
                                                <Line X1="47" Y1="12" X2="47" Y2="82" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                                <Line X1="12" Y1="47" X2="82" Y2="47" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Opacity="0.16" />
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushInfoBorder}" BorderThickness="1.4">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="LeftJoystickKnobTransform" />
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{DynamicResource ColorShadow}" Opacity="0.24" />
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="摇杆输入" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,6" />
                                                <TextBlock x:Name="LeftJoystickStatusText" Text="未启用摇杆" Foreground="{DynamicResource BrushSubText}" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock x:Name="LeftJoystickAxisText" Text="轴向：-" Foreground="{DynamicResource BrushText}" FontSize="12.5" Margin="0,0,0,3" />
                                                <TextBlock x:Name="LeftJoystickRawText" Text="原始：-" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" Margin="0,0,0,3" />
                                                <TextBlock x:Name="LeftJoystickSwitchText" Text="按键：未配置" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1" Width="1" Background="{DynamicResource BrushTrack}" Margin="0,18" />

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="右手控制器"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushPrimary}"
                                               Margin="0,0,0,12" />
                                    <controls:FingerCard x:Name="FingerRThumb" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerRIndex" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerRMiddle" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerRRing" Margin="0,0,0,10" />
                                    <controls:FingerCard x:Name="FingerRPinky" Margin="0,0,0,10" />

                                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushInputReadonly}" CornerRadius="12" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="94" Height="94" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource BrushPanel}" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1.2" />
                                                <Ellipse x:Name="RightJoystickActiveRing" Width="62" Height="62" Fill="{DynamicResource BrushInfoBg}" Stroke="{DynamicResource BrushInfoBorder}" StrokeThickness="1" />
                                                <Line X1="47" Y1="12" X2="47" Y2="82" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                                <Line X1="12" Y1="47" X2="82" Y2="47" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Opacity="0.16" />
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushInfoBorder}" BorderThickness="1.4">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="RightJoystickKnobTransform" />
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="{DynamicResource ColorShadow}" Opacity="0.24" />
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="摇杆输入" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,6" />
                                                <TextBlock x:Name="RightJoystickStatusText" Text="未启用摇杆" Foreground="{DynamicResource BrushSubText}" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock x:Name="RightJoystickAxisText" Text="轴向：-" Foreground="{DynamicResource BrushText}" FontSize="12.5" Margin="0,0,0,3" />
                                                <TextBlock x:Name="RightJoystickRawText" Text="原始：-" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" Margin="0,0,0,3" />
                                                <TextBlock x:Name="RightJoystickSwitchText" Text="按键：未配置" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="CompactRealtimePanel" Visibility="Collapsed">
                            <Border Background="{DynamicResource BrushPanel}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18,14"
                                    Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="左手"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushSubText}" />
                                    <controls:CompactFingerCard x:Name="CompactFingerLThumb" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerLIndex" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerLMiddle" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerLRing" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerLPinky" Margin="0,0,8,0" />

                                    <Grid Width="34" Height="34" Margin="0,0,34,0" VerticalAlignment="Top">
                                        <Ellipse Stroke="{DynamicResource BrushPrimary}" StrokeThickness="2.2" Fill="Transparent" />
                                        <Ellipse x:Name="CompactLeftJoystickActiveRing" Width="18" Height="18" Fill="{DynamicResource BrushInfoBg}" Stroke="{DynamicResource BrushInfoBorder}" StrokeThickness="1" />
                                        <Line X1="17" Y1="7" X2="17" Y2="27" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                        <Line X1="7" Y1="17" X2="27" Y2="17" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushInfoBorder}" BorderThickness="1">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="CompactLeftJoystickKnobTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="右手"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushSubText}" />
                                    <controls:CompactFingerCard x:Name="CompactFingerRThumb" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerRIndex" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerRMiddle" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerRRing" Margin="0,0,8,0" />
                                    <controls:CompactFingerCard x:Name="CompactFingerRPinky" Margin="0,0,8,0" />

                                    <Grid Width="34" Height="34" VerticalAlignment="Top">
                                        <Ellipse Stroke="{DynamicResource BrushPrimary}" StrokeThickness="2.2" Fill="Transparent" />
                                        <Ellipse x:Name="CompactRightJoystickActiveRing" Width="18" Height="18" Fill="{DynamicResource BrushInfoBg}" Stroke="{DynamicResource BrushInfoBorder}" StrokeThickness="1" />
                                        <Line X1="17" Y1="7" X2="17" Y2="27" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                        <Line X1="7" Y1="17" X2="27" Y2="17" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushInfoBorder}" BorderThickness="1">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="CompactRightJoystickKnobTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="校准左手"
                                    Height="40"
                                    Click="OnCalibrateLeftClick" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="校准右手"
                                    Height="40"
                                    Click="OnCalibrateRightClick" />
                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="重置双手校准"
                                    Width="120"
                                    Height="40"
                                    Click="OnResetCalibrationClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="手指滤波与算法设置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,18" />

                        <StackPanel x:Name="NormalTuningPanel" Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="手指响应灵敏度" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="SensitivityValueText"
                                                   Text="中等"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider x:Name="SensitivitySlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="1"
                                            Maximum="3"
                                            Value="2"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnTuningSliderChanged" />
                                    <TextBlock Text="调节手指动作的整体跟随速率。推荐高精度或普通状态。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="防抖强度" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="AntiShakeValueText"
                                                   Text="低防抖"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider x:Name="AntiShakeSlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="1"
                                            Maximum="3"
                                            Value="1"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnTuningSliderChanged" />
                                    <TextBlock Text="预防手腕微颤造成的手指虚幻抽搐。越强越稳定，但会有细微惯性。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ProTuningPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="平滑系数" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="SmoothingValueText"
                                                   Text="0.15"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider x:Name="SmoothingSlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="0.05"
                                            Maximum="1.0"
                                            Value="0.15"
                                            ValueChanged="OnTuningSliderChanged" />
                                    <TextBlock Text="公式 y_t = α * x_t + (1 - α) * y_{t-1}。常规推荐 0.12 - 0.25。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="底噪死区" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="DeadzoneValueText"
                                                   Text="3%"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider x:Name="DeadzoneSlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="0"
                                            Maximum="15"
                                            Value="3"
                                            ValueChanged="OnTuningSliderChanged" />
                                    <TextBlock Text="设定初始剪裁零区（%），剔除传感器底噪。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="动态跟随强度" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="QFactorValueText"
                                                   Text="0.015"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider x:Name="QFactorSlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="0.001"
                                            Maximum="0.1"
                                            Value="0.015"
                                            ValueChanged="OnTuningSliderChanged" />
                                    <TextBlock Text="Q 越低越平滑，Q 越高越强调动态跟随。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border BorderThickness="0" Background="{DynamicResource BrushInputReadonly}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="底层同步" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushText}" Margin="0,0,0,4" />
                                <TextBlock Text="更改后会自动同步到底层服务与 SteamVR 驱动。"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource BrushSubText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>


                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="虚拟控制器 6DoF 偏移" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="调整 OpenFinger 虚拟控制器相对真实手柄的本地空间位置与旋转。位置单位为米，旋转单位为度。"
                                   Foreground="{DynamicResource BrushSubText}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushInputReadonly}" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="左手虚拟控制器" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,12" />
                                    <TextBlock Text="位置偏移（m）" Style="{StaticResource InputLabelStyle}" />
                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="X 左右" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="LeftPosePositionXTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,0">
                                            <TextBlock Text="Y 上下" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="LeftPosePositionYTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Z 前后" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="LeftPosePositionZTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="旋转偏移（°）" Style="{StaticResource InputLabelStyle}" />
                                    <UniformGrid Columns="3" Margin="0,0,0,14">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Pitch" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="LeftPoseRotationPitchTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,0">
                                            <TextBlock Text="Yaw" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="LeftPoseRotationYawTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Roll" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="LeftPoseRotationRollTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="保存左手偏移"
                                                Width="132"
                                                Margin="0,0,10,0"
                                                Click="OnApplyLeftPoseOffsetClick" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="重置"
                                                Width="76"
                                                Click="OnResetLeftPoseOffsetClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushInputReadonly}" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="右手虚拟控制器" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,12" />
                                    <TextBlock Text="位置偏移（m）" Style="{StaticResource InputLabelStyle}" />
                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="X 左右" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="RightPosePositionXTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,0">
                                            <TextBlock Text="Y 上下" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="RightPosePositionYTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Z 前后" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="RightPosePositionZTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="旋转偏移（°）" Style="{StaticResource InputLabelStyle}" />
                                    <UniformGrid Columns="3" Margin="0,0,0,14">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Pitch" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="RightPoseRotationPitchTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,0">
                                            <TextBlock Text="Yaw" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="RightPoseRotationYawTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Roll" FontSize="11.5" Foreground="{DynamicResource BrushSubText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="RightPoseRotationRollTextBox" Style="{StaticResource TextInputStyle}" Text="0" KeyDown="OnPoseOffsetTextBoxKeyDown" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="保存右手偏移"
                                                Width="132"
                                                Margin="0,0,10,0"
                                                Click="OnApplyRightPoseOffsetClick" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="重置"
                                                Width="76"
                                                Click="OnResetRightPoseOffsetClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="摇杆映射" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushInputReadonly}" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="左手摇杆" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,12" />
                                    <TextBlock Text="轴向映射" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox x:Name="LeftJoystickAxisModeComboBox"
                                              Style="{StaticResource SelectInputStyle}"
                                              Margin="0,0,0,12"
                                              SelectionChanged="OnJoystickSettingChanged" />
                                    <TextBlock Text="按下摇杆按键时" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox x:Name="LeftJoystickClickActionComboBox"
                                              Style="{StaticResource SelectInputStyle}"
                                              Margin="0,0,0,12"
                                              SelectionChanged="OnJoystickSettingChanged" />
                                    <TextBlock Text="摇杆方向" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox x:Name="LeftJoystickOrientationComboBox"
                                              Style="{StaticResource SelectInputStyle}"
                                              Margin="0,0,0,12"
                                              SelectionChanged="OnJoystickSettingChanged" />
                                    <TextBlock Text="如果上下左右方向不对，就在这里切换到更贴近当前摇杆朝向的方案。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,-4,0,12" />
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="摇杆死区" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="LeftJoystickDeadzoneValueText"
                                                   Text="8%"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <Slider x:Name="LeftJoystickDeadzoneSlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="0"
                                            Maximum="25"
                                            Value="8"
                                            ValueChanged="OnJoystickDeadzoneChanged" />
                                    <TextBlock x:Name="LeftJoystickCenterText"
                                               Text="中心：自动（2048 / 2048）"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               Margin="0,10,0,10" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="自动校准方向"
                                                Margin="0,0,10,10"
                                                Click="OnAutoCalibrateLeftJoystickDirectionClick" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="记录中心"
                                                Margin="0,0,10,10"
                                                Click="OnCaptureLeftJoystickCenterClick" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="重置中心"
                                                Margin="0,0,10,10"
                                                Click="OnResetLeftJoystickCalibrationClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushInputReadonly}" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="右手摇杆" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,12" />
                                    <TextBlock Text="轴向映射" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox x:Name="RightJoystickAxisModeComboBox"
                                              Style="{StaticResource SelectInputStyle}"
                                              Margin="0,0,0,12"
                                              SelectionChanged="OnJoystickSettingChanged" />
                                    <TextBlock Text="按下摇杆按键时" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox x:Name="RightJoystickClickActionComboBox"
                                              Style="{StaticResource SelectInputStyle}"
                                              Margin="0,0,0,12"
                                              SelectionChanged="OnJoystickSettingChanged" />
                                    <TextBlock Text="摇杆方向" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox x:Name="RightJoystickOrientationComboBox"
                                              Style="{StaticResource SelectInputStyle}"
                                              Margin="0,0,0,12"
                                              SelectionChanged="OnJoystickSettingChanged" />
                                    <TextBlock Text="如果上下左右方向不对，就在这里切换到更贴近当前摇杆朝向的方案。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,-4,0,12" />
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="摇杆死区" Style="{StaticResource InputLabelStyle}" Margin="0" />
                                        <TextBlock x:Name="RightJoystickDeadzoneValueText"
                                                   Text="8%"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <Slider x:Name="RightJoystickDeadzoneSlider"
                                            Style="{StaticResource AppSliderStyle}"
                                            Minimum="0"
                                            Maximum="25"
                                            Value="8"
                                            ValueChanged="OnJoystickDeadzoneChanged" />
                                    <TextBlock x:Name="RightJoystickCenterText"
                                               Text="中心：自动（2048 / 2048）"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12"
                                               Margin="0,10,0,10" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="自动校准方向"
                                                Margin="0,0,10,10"
                                                Click="OnAutoCalibrateRightJoystickDirectionClick" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="记录中心"
                                                Margin="0,0,10,10"
                                                Click="OnCaptureRightJoystickCenterClick" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="重置中心"
                                                Margin="0,0,10,10"
                                                Click="OnResetRightJoystickCalibrationClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
