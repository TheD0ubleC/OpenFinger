<UserControl x:Class="OpenFinger.Control.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OpenFinger.Control.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBg}"
             Style="{StaticResource PageTransitionStyle}">
    <UserControl.Resources>
        <Style x:Key="DeviceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,36" MaxWidth="1080">
            <controls:PageHeader Title="设备" Description="管理连接、配置写入和设备维护。" />

            <Border BorderBrush="{DynamicResource BrushInfoBorder}" BorderThickness="1" Background="{DynamicResource BrushPanelAlt}" CornerRadius="10" Padding="16,14" Margin="0,0,0,24">
                <TextBlock Text="配置写入需要设备通过 USB 接入。删除记录只会移除本地识别信息，不会影响设备本体。"
                           Foreground="{DynamicResource BrushInfoText}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="已知设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="刷新"
                                        Height="28"
                                        MinWidth="76"
                                        Click="OnRefreshDevicesClick" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="DeviceListItemStyle" />
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border x:Name="DeviceCard" Style="{StaticResource CardBorderStyle}" Padding="18,16" CornerRadius="16">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushText}" />
                                                        <Border x:Name="StatusBadge"
                                                                DockPanel.Dock="Right"
                                                                Background="{DynamicResource BrushPanelAlt}"
                                                                BorderBrush="{DynamicResource BrushBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="8,4">
                                                            <TextBlock x:Name="StatusBadgeText"
                                                                       Text="{Binding Status}"
                                                                       Foreground="{DynamicResource BrushSubText}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{DynamicResource BrushSubText}"
                                                               FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8" />
                                                    <TextBlock Text="{Binding ConnectionSummary}"
                                                               Foreground="{DynamicResource BrushSubText}"
                                                               FontSize="12.5"
                                                               Margin="0,0,0,12" />

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="固件" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding FirmwareVersion}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="校准" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding CalibrationState}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="板型" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding BoardTarget}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="最近连接" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding LastSeenText}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="可用手指模块" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding FingerModuleSummary}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="摇杆状态" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding JoystickConnectionText}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="电量" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding BatterySummary}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="电压" Foreground="{DynamicResource BrushSubText}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding BatteryVoltageText}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="佩戴方式"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource BrushSubText}"
                                                                   FontSize="13" />
                                                        <ComboBox Grid.Column="1"
                                                                  Style="{StaticResource SelectInputStyle}"
                                                                  SelectedValue="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Tag"
                                                                  Tag="{Binding}"
                                                                  SelectionChanged="OnDeviceRoleChanged">
                                                            <ComboBoxItem Content="左手" Tag="left" />
                                                            <ComboBoxItem Content="右手" Tag="right" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <WrapPanel>
                                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                                Margin="0,0,10,10"
                                                                Content="写入配置"
                                                                Tag="{Binding}"
                                                                Click="OnProvisionDeviceClick" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Margin="0,0,10,10"
                                                                Content="识别"
                                                                Tag="{Binding}"
                                                                Click="OnIdentifyDeviceClick" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Margin="0,0,10,10"
                                                                Content="固件刷写"
                                                                Tag="{Binding}"
                                                                Click="OnOpenFirmwareClick" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Margin="0,0,10,10"
                                                                Content="删除记录"
                                                                Tag="{Binding}"
                                                                Click="OnForgetDeviceClick" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BrushSuccessBg}" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{DynamicResource BrushSuccessBorder}" />
                                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{DynamicResource BrushSuccessText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter TargetName="DeviceCard" Property="BorderBrush" Value="{DynamicResource BrushActiveBorder}" />
                                                <Setter TargetName="DeviceCard" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="DeviceCard" Property="Background" Value="{DynamicResource BrushPrimarySoft}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="配置写入" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SelectedDevice.DisplayName, TargetNullValue=未选择设备, FallbackValue=未选择设备}"
                                       Foreground="{DynamicResource BrushText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedDevice.ConnectionSummary, TargetNullValue=先从左侧选择设备，再写入配置。, FallbackValue=先从左侧选择设备，再写入配置。}"
                                       Foreground="{DynamicResource BrushSubText}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,18" />

                            <TextBlock Text="Wi-Fi 名称 (SSID)" Style="{StaticResource InputLabelStyle}" />
                            <TextBox Style="{StaticResource TextInputStyle}"
                                     Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14" />

                            <TextBlock Text="Wi-Fi 密码" Style="{StaticResource InputLabelStyle}" />
                            <TextBox x:Name="WifiPasswordTextBox"
                                     Style="{StaticResource TextInputStyle}"
                                     Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="主机 IP" Style="{StaticResource InputLabelStyle}" />
                                    <TextBox Style="{StaticResource TextInputStyle}" Text="{Binding HostIp, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="UDP 端口" Style="{StaticResource InputLabelStyle}" />
                                    <TextBox Style="{StaticResource TextInputStyle}" Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="默认手型" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox Style="{StaticResource SelectInputStyle}"
                                      SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,18">
                                <ComboBoxItem Content="左手" Tag="left" />
                                <ComboBoxItem Content="右手" Tag="right" />
                            </ComboBox>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="写入配置"
                                    Height="38"
                                    HorizontalAlignment="Stretch"
                                    Click="OnProvisionClick" />

                            <Border Background="{DynamicResource BrushPanelAlt}"
                                     BorderBrush="{DynamicResource BrushBorder}"
                                     BorderThickness="1"
                                     CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,14,0,0">
                                <TextBlock Text="{Binding StatusLine}"
                                           Foreground="{DynamicResource BrushText}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
