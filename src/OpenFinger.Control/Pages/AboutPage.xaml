<UserControl x:Class="OpenFinger.Control.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OpenFinger.Control.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBg}"
             Style="{StaticResource PageTransitionStyle}">
    <UserControl.Resources>
        <Style x:Key="VersionBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushActiveBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="MiniLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushHover}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrushActiveBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushPrimarySoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrushActiveBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,36" MaxWidth="980">
            <controls:PageHeader Title="关于" Description="了解 OpenFinger 的版本信息和相关资源。" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="112"
                            Height="112"
                            Background="{DynamicResource BrushPrimarySoft}"
                            BorderBrush="{DynamicResource BrushActiveBorder}"
                            BorderThickness="1"
                            CornerRadius="24">
                        <Image Source="/Assets/OpenFinger.png"
                               Width="96"
                               Height="96"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="OpenFinger"
                                   Foreground="{DynamicResource BrushText}"
                                   FontSize="32"
                                   FontWeight="Bold" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource VersionBadgeStyle}">
                                <TextBlock x:Name="VersionText"
                                           Text="版本 -"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource VersionBadgeStyle}">
                                <TextBlock x:Name="ProtocolVersionText"
                                           Text="协议版本 -"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Text="OpenFinger(Kit) 开源的轻量手指追踪器"
                                   Foreground="{DynamicResource BrushSubText}"
                                   FontSize="16"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Style="{StaticResource MiniLinkButtonStyle}"
                        Width="132"
                        Height="42"
                        Margin="0,0,12,0"
                        Click="OnBilibiliClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="7"
                                Background="{DynamicResource BrushIconTile}">
                            <Image Source="/Assets/Bilibili.png"
                                   Width="20"
                                   Height="20"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="哔哩哔哩"
                                   Foreground="{DynamicResource BrushText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MiniLinkButtonStyle}"
                        Width="112"
                        Height="42"
                        Click="OnGitHubClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="7"
                                Background="{DynamicResource BrushIconTile}">
                            <Border Width="20"
                                    Height="20"
                                    Background="{DynamicResource BrushText}"
                                    VerticalAlignment="Center">
                                <Border.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/GitHub.png" Stretch="Uniform" />
                                </Border.OpacityMask>
                            </Border>
                        </Border>
                        <TextBlock Text="GitHub"
                                   Foreground="{DynamicResource BrushText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MiniLinkButtonStyle}"
        Width="268"
        Height="42"
        Margin="12,0,0,0"
        Click="OnVRChatClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28"
                Height="28"
                CornerRadius="7"
                Background="{DynamicResource BrushIconTile}">
                            <Image Source="/Assets/VRChat.png"
                   Width="20"
                   Height="20"
                   Stretch="Uniform"
                   VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="我的个人VRChat(欢迎来找我玩)"
                   Foreground="{DynamicResource BrushText}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
