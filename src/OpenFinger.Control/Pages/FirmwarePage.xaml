<UserControl x:Class="OpenFinger.Control.Pages.FirmwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OpenFinger.Control.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBg}"
             Style="{StaticResource PageTransitionStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,36" MaxWidth="980">
            <controls:PageHeader Title="固件刷写" Description="使用预编译固件包刷写设备，并自动验证结果。" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="刷写设置" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="刷写串口" Foreground="{DynamicResource BrushSubText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource SelectInputStyle}"
                                  ItemsSource="{Binding FirmwarePorts}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FirmwarePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Margin="110,8,0,0"
                                Text="最近 30 秒内新接入的串口会标注接入时间；如果没有自动出现，可以手动刷新。"
                                Foreground="{DynamicResource BrushSubText}"
                                FontSize="12.5"
                                TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="固件来源" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="来源" Foreground="{DynamicResource BrushSubText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  x:Name="FirmwareSourceComboBox"
                                  Style="{StaticResource SelectInputStyle}"
                                  ItemsSource="{Binding FirmwareSourceOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FirmwareSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="OnFirmwareSourceChanged" />
                    </Grid>

                    <StackPanel x:Name="ExternalSourcePanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="外部固件包清单" Style="{StaticResource InputLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource TextInputStyle}"
                                     Text="{Binding FirmwareExternalPackagePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="选择固件"
                                    Click="OnBrowsePackageClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="OnlineSourcePanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="在线目录地址" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource TextInputStyle}"
                                 Text="{Binding FirmwareOnlineCatalogUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Border Background="{DynamicResource BrushInputReadonly}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="FirmwareSourceStatusText"
                                   Text="等待检查固件包"
                                   Foreground="{DynamicResource BrushSubText}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="刷写内容" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="目标板型" Foreground="{DynamicResource BrushSubText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource SelectInputStyle}"
                                  ItemsSource="{Binding FirmwareTargetOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FirmwareTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="目标固件" Foreground="{DynamicResource BrushSubText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  x:Name="PackageComboBox"
                                  Style="{StaticResource SelectInputStyle}"
                                  ItemsSource="{Binding FirmwarePackages}"
                                  DisplayMemberPath="Summary"
                                  SelectedItem="{Binding SelectedFirmwarePackage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="OnFirmwarePackageChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="回报率" Foreground="{DynamicResource BrushSubText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource SelectInputStyle}"
                                  ItemsSource="{Binding FirmwareReportRateOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FirmwareReportRateHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <controls:LabeledReadonlyField x:Name="CurrentFirmwareField" Label="当前固件" Value="未识别" />
                    <controls:LabeledReadonlyField x:Name="TargetFirmwareField" Label="待刷写内容" Value="未选择" />
                    <controls:LabeledReadonlyField x:Name="RecommendationField" Label="匹配建议" Value="等待匹配" />

                    <Border Background="{DynamicResource BrushWarningBg}" BorderBrush="{DynamicResource BrushWarningBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <TextBlock x:Name="BootHintTextBlock"
                                   Text="刷写前请确认设备可进入下载模式。"
                                   Foreground="{DynamicResource BrushWarningText}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="AdvancedOptionsPanel" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="高级覆写" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <TextBlock Text="这里只有在高级模式下才需要改。普通刷写建议直接使用弹窗里的开发板配置。"
                               Foreground="{DynamicResource BrushSubText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="拇指 ADC" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareThumbPin, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="食指 ADC" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareIndexPin, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="中指 ADC" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareMiddlePin, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="无名指 ADC" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareRingPin, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="小指 ADC" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwarePinkyPin, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="追踪开关" Style="{StaticResource InputLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareSwitchPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareTrackingSwitchPin, Mode=TwoWay}" />
                                <ComboBox Grid.Column="2" Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareTrackingSwitchModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareTrackingSwitchMode, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BrushInputReadonly}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="摇杆引脚（可选）" Style="{StaticResource InputLabelStyle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VRX ADC" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareOptionalAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareJoystickVrxPin, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <TextBlock Text="VRY ADC" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareOptionalAdcPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareJoystickVryPin, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SW GPIO" Style="{StaticResource InputLabelStyle}" />
                                    <ComboBox Style="{StaticResource SelectInputStyle}" ItemsSource="{Binding FirmwareOptionalSwitchPinOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirmwareJoystickSwPin, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Text="没有接摇杆时保持“不使用”；常见模块一般就是 VRX、VRY、SW 三路。"
                                               Foreground="{DynamicResource BrushSubText}"
                                               FontSize="12.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="StartFlashButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0" Content="开始刷写" Click="OnStartFlashClick" />
                <Button x:Name="RefreshCatalogButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Content="刷新固件包" Click="OnRefreshCatalogClick" />
                <Button x:Name="RefreshPortsButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Content="刷新串口" Click="OnRefreshPortsClick" />
                <Button x:Name="ReverifyButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Content="重新验证" Click="OnReverifyClick" />
                <Button x:Name="ClearLogButton" Style="{StaticResource SecondaryButtonStyle}" Content="清空日志" Click="OnClearLogClick" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="刷写进度" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <ProgressBar x:Name="FirmwareProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"
                                 Style="{StaticResource FingerProgressStyle}"
                                 Margin="0,0,0,10" />
                    <TextBlock x:Name="FirmwareProgressTextBlock"
                               Text="等待开始"
                               Foreground="{DynamicResource BrushSubText}"
                               FontSize="13"
                               Margin="0,0,0,14" />

                    <TextBlock Text="过程记录" Style="{StaticResource InputLabelStyle}" />
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushInputReadonly}" Padding="12,10">
                        <TextBox Text="{Binding FirmwareFriendlyOutput}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="144"
                                 FontSize="13" />
                    </Border>

                    <StackPanel x:Name="RawLogPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="原始刷写日志" Style="{StaticResource InputLabelStyle}" />
                        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushCodeBg}" Padding="12,10">
                            <TextBox Text="{Binding FirmwareOutput}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource BrushCodeText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="170"
                                     FontFamily="Consolas"
                                     FontSize="12.5" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
